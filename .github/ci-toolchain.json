{
  "schema-version": 1,
  "documentation-python": "3.x",
  "tooling-python-minimum": "3.10",
  "npm-tools": {
    "markdownlint-cli2": {
      "package": "markdownlint-cli2",
      "version": "0.23.2"
    }
  },
  "standalone-tools": {
    "actionlint": {
      "repository": "rhysd/actionlint",
      "version": "1.7.12",
      "tag-template": "v{version}",
      "asset-template": "actionlint_{version}_linux_amd64.tar.gz",
      "archive-format": "tar.gz",
      "executable-path-template": "actionlint",
      "sha256": "8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8"
    },
    "shellcheck": {
      "repository": "koalaman/shellcheck",
      "version": "0.11.0",
      "tag-template": "v{version}",
      "asset-template": "shellcheck-v{version}.linux.x86_64.tar.xz",
      "archive-format": "tar.xz",
      "executable-path-template": "shellcheck-v{version}/shellcheck",
      "sha256": "8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198"
    }
  }
}
