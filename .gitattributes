# Normalize text files to LF across development platforms and Linux CI.
* text=auto eol=lf
*.sh text eol=lf

# Leave binary assets untouched.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.zip  binary

# Keep repository-only development files out of generated source archives.
/.github/**       export-ignore
# The plugin release archive includes these README-linked policy and reminder
# files so the distributed README remains self-contained.
/.github/ci-toolchain.json            -export-ignore
/.github/freshness-trackers.json      -export-ignore
/.github/official-docs-trackers.json  -export-ignore
/.github/python-support.json          -export-ignore
/.github/workflows                    -export-ignore
/.github/workflows/**                 export-ignore
/.github/workflows/freshness.yml      -export-ignore
/.github/workflows/official-docs.yml  -export-ignore
/.gitattributes   export-ignore
/.gitignore       export-ignore
/.editorconfig    export-ignore
/.coveragerc      export-ignore
/pyproject.toml   export-ignore
/requirements-dev.in export-ignore
/requirements-dev.txt export-ignore
/requirements-mutation.in export-ignore
/requirements-mutation.txt export-ignore
/PLUGIN_SUBMISSION.md export-ignore
/PLUGIN_SUBMISSION.md -export-ignore
scripts/**        export-ignore
tests/**          export-ignore

# Plugin payload is complete source, including dotfile templates and scripts.
skills/**          -export-ignore
